{
	"name": "chance-yoyogi/project",
	"description": "Project description",
	"type": "project",
	"license": "proprietary",
	"require-dev": {
		"phpstan/extension-installer": "^1.4",
		"wp-coding-standards/wpcs": "^3.1",
		"phpunit/phpunit": "^9.6",
		"yoast/wp-test-utils": "^1.2",
		"brain/monkey": "^2.6"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:plugins": "phpunit --testsuite 'Plugin Tests'",
		"test:theme": "phpunit --testsuite 'Theme Tests'",
		"test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-html ./reports/coverage",
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"lint:tests": "phpcs ./tests/",
		"lint:src": "phpcs ./src/"
	}
}
