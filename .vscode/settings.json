{
"workbench.colorCustomizations": {
    "activityBar.background": "#dc6b9a",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#000000",
    "activityBarBadge.background": "#fdfdfd",
    "activityBarBadge.foreground": "#000000",
    "titleBar.activeBackground": "#dc6b9a",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#dc6b9a",
    "titleBar.inactiveForeground": "#000000",
    "titleBar.border": "#111",
    "titleBar.foreground": "#000000",
  },
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "calendar",
    "com_dotnet",
    "Core",
    "ctype",
    "curl",
    "date",
    "dba",
